# 复制成 .env 后填写；.env 已被 .gitignore 排除，不会进仓库
# 生成强随机密钥：  python -c "import secrets;print(secrets.token_urlsafe(24))"
#                  openssl rand -hex 24
#
# 【必填】设备端和服务端必须用同一个值。设备串口执行：
#   cam key <这里的值>
CAM_API_KEY=please-change-me-to-a-long-random-string

# 观看端是否也要鉴权：1=需要登录（默认，推荐）；0=内网调试时免密
PROTECT_VIEW=1

# 是否允许 ?key= 传密钥（给 VLC 等只能填 URL 的播放器）
# 默认 0：URL 会进浏览器历史和服务端 access log，能不用就不用
ALLOW_KEY_IN_QUERY=0

# 网页登录会话有效期（秒），默认 7 天
SESSION_TTL=604800

# 前面挂了 HTTPS 反向代理时设 1（cookie 加 Secure 标记）
COOKIE_SECURE=0

# 以下保持默认即可
SAVE_EVERY=0
JPEG_QUALITY=80
LOG_LEVEL=INFO
