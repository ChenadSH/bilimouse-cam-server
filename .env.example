# 复制成 .env 后填写；.env 已被 .gitignore 排除，不会进仓库
# 生成强随机密钥：  python -c "import secrets;print(secrets.token_urlsafe(24))"
#                  openssl rand -hex 24
#
# 【必填】设备端和服务端必须用同一个值。设备串口执行：
#   cam key <这里的值>
CAM_API_KEY=please-change-me-to-a-long-random-string

# 宿主机对外端口，默认 39110。改这里即可，docker compose 与 update.sh
# 会同时跟随；设备端 cam url 也要改成新端口。
HOST_PORT=39110

# 设备端实际用来访问服务端的地址（云服务器填公网 IP 或域名，内网填局域网 IP）。
# 只影响 update.sh 末尾打印的「设备端填」提示，不影响服务本身；
# 不填时脚本退回用 hostname -I 的局域网 IP + HOST_PORT 拼一个。
# 固件里的编译默认值在 main/app/user_config.h（此处改动不会自动同步过去）。
PUBLIC_URL=http://124.221.91.97:39110/

# 构建镜像时 pip 使用的源。国内默认清华源，避免 files.pythonhosted.org
# 读超时；海外机器或公司内网可改成官方源 https://pypi.org/simple
# 或自建镜像地址。改完执行 ./update.sh --build 重新构建。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 基础镜像地址，默认官方 Docker Hub。国内若报 registry-1.docker.io EOF，
# 取消下面这行的注释换国内加速源（镜像内容完全相同，只是拉取地址不同）：
# BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
BASE_IMAGE=python:3.12-slim

# 观看端是否也要鉴权：1=需要登录（默认，推荐）；0=内网调试时免密
PROTECT_VIEW=1

# 是否允许 ?key= 传密钥（给 VLC 等只能填 URL 的播放器）
# 默认 0：URL 会进浏览器历史和服务端 access log，能不用就不用
ALLOW_KEY_IN_QUERY=0

# 网页登录会话有效期（秒），默认 7 天
SESSION_TTL=604800

# 前面挂了 HTTPS 反向代理时设 1（cookie 加 Secure 标记）
COOKIE_SECURE=0

# ── 按需推流（省流量 / 设备算力 / 服务器算力）──────────────────────
# 1=只有「有人打开网页」或「正在录制」时才让设备推流（默认，推荐）。
# 设备平时只每 GATE_POLL_MS 发一个几十字节的 GET 问一次，不采集不发大帧。
# 设 0 则退回老行为：设备一直推（调试 / 兼容旧固件时用）。
GATE_ENABLED=1
# 网页心跳有效期（秒）。前端每 3s 报活，超过这个时间没报活就认为网页关了。
PRESENCE_TTL=8
# 设备待机时轮询闸门的间隔（毫秒），由服务端下发给设备。
GATE_POLL_MS=2000

# ── 网页录屏 ──────────────────────────────────────────────────
# 单次录制最长秒数，默认 600 = 10 分钟，到点自动停。
RECORD_MAX_SECONDS=600
# 录制中连续多少秒没收到新帧，判定设备掉线并自动停止录制。
# 设备 2fps（0.5s/帧），8 秒足够容忍 WiFi 抖动。
RECORD_OFFLINE_TIMEOUT=8
# 网页回放帧率（近似还原录制节奏）。
RECORD_PLAY_FPS=2
# 录制文件按日期归档用的时区偏移（小时）。容器通常是 UTC，默认 +8 北京时间。
TZ_OFFSET_HOURS=8

# 以下保持默认即可
SAVE_EVERY=0
JPEG_QUALITY=80
LOG_LEVEL=INFO
